<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear first (HOUSE-01): without it this file ADDS to whatever sources the machine has
         globally. On an operator machine carrying a private Azure DevOps feed that produced 6 ×
         NU1900 ("unable to load the service index") on every build — a warning about someone's
         laptop, not about this repo. Titan takes every package from nuget.org. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
